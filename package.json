{
  "name": "catryna-wikinelli",
  "version": "1.3.2",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "catryna": "./src/cli.ts",
    "catryna-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "doctor": "bun run src/cli.ts doctor",
    "test": "bun test",
    "typecheck": "cd frontend && bunx tsc --noEmit",
    "lint": "bun run src/cli.ts lint",
    "drift": "bun run src/cli.ts drift",
    "check": "bun run typecheck && bun test && bun run lint && bun run drift"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
